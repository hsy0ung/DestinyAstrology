# This file contains names and non-secret defaults only. Copy to .env.local for local development.
# Never commit .env.local or put credential values into chat.
ASTRO_AI_PROVIDER=openai
ASTRO_AI_MODEL=gpt-4o-mini
# Secure environment setting; absent = clearly labeled example answers.
ASTRO_AI_API_KEY=
# Public Toss client key (test key for development).
ASTRO_TOSS_CLIENT_KEY=
# Cloud proxy: securely provide the entire Toss Authorization header (Basic ...), passed unchanged.
ASTRO_TOSS_AUTH_HEADER=
# Local deployments can instead read a raw Toss secret key; leave unset in proxy-backed cloud.
TOSS_SECRET_KEY=
# Optional fixed origin for CSRF checks and secure session cookies when behind a reverse proxy.
ASTRO_APP_URL=
# Optional database location (default: .data/astro.sqlite). Must be persistent for accounts/credits.
ASTRO_DB_PATH=
